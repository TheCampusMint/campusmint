# Server-only Supabase configuration. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
STUDENT_SMS_VERIFICATION_REQUIRED=false

# Browser-safe Supabase project values. Publishable/anon keys are intentionally
# public; authorization is enforced by RLS. Never use the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Reserved for a future authenticated cron/sync endpoint.
CAMPUS_DATA_SYNC_SECRET=replace-with-a-long-random-value

# Server-only Google Places API (New) credential. Never expose this with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=your-server-only-google-places-api-key
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_SEARCH_DAILY_LIMIT=100
GOOGLE_PLACES_DETAILS_DAILY_LIMIT=1000
GOOGLE_PLACES_PHOTO_DAILY_LIMIT=400

# Server-only quota identity secret. Configure before rollout; never expose publicly.
SECURITY_RATE_LIMIT_SECRET=replace-with-a-long-random-value
CRON_SECRET=replace-with-a-long-random-value

# Personal Team builds use com.campusmint.app; live paid capabilities remain off.
APPLE_BUNDLE_ID=com.campusmint.app
APPLE_TEAM_ID=
APP_ATTEST_ENABLED=false
APP_ATTEST_REQUIRED=false
APP_ATTEST_REVIEWED=false
APP_ATTEST_ALLOW_DEVELOPMENT=false

# Server-only OTP hashing secret. Use a long random value with durable
# challenge storage in production. Never prefix this with NEXT_PUBLIC_.
STUDENT_VERIFICATION_HASH_SECRET=replace-with-a-long-random-value

# Explicit local-test switches. Keep all false in production/preview.
NEXT_PUBLIC_CAMPUS_MINT_ENABLE_FIXTURES=false
NEXT_PUBLIC_CAMPUS_MINT_ENABLE_DEV_CONTROLS=false
CAMPUS_MINT_EXPOSE_DEVELOPMENT_OTP=false
