    "test:social": "npm run test:event-timing && npm run test:organizations && npm run test:organization-identity && npm run test:institution-eligibility && npm run test:student-verification && npm run test:section-memory && npm run test:event-moments && npm run test:unified-search && npm run test:navigation && npm run test:groups && npm run test:mint-social && npm run test:notification-sounds && npm run test:sports && npm run test:mint-feed-ranking"
