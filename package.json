    "test:student-verification": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/studentVerification.test.mjs",
    "test:section-memory": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/sectionMemory.test.mjs",
    "test:event-moments": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/eventMoments.test.mjs",
    "test:unified-search": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unifiedSearch.test.mjs",
